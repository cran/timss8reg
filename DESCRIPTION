Package: timss8reg
Type: Package
Title: Helper Functions for Regression Analysis of TIMSS Grade 8
        Student Data
Version: 0.1.0
Authors@R: c(
    person("Elfin Harse Saputra", "Harefa",
           email = "elfinharsesaputraharefaa@gmail.com",
           role = c("aut", "cre")),
    person("Fadhlul", "Mubarak",
           email = "mubarakfadhlul@gmail.com",
